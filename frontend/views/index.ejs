<%- include('partials/header', { pageTitle: 'My Library' }) %>

<section class="library-hero">
  <h1>My Library</h1>
  <p class="hero-sub">Books I've read — with notes on what I found most valuable.</p>
</section>

<!-- Sort Controls -->
<div class="sort-bar">
  <span class="sort-label">Sort by</span>
  <div class="sort-pills">
    <a href="/?sort=date_read" class="pill <%= sort === 'date_read' ? 'active' : '' %>">Most Recent</a>
    <a href="/?sort=rating"    class="pill <%= sort === 'rating'    ? 'active' : '' %>">Top Rated</a>
    <a href="/?sort=title"     class="pill <%= sort === 'title'     ? 'active' : '' %>">A → Z</a>
  </div>
  <span class="book-count"><%= books.length %> book<%= books.length !== 1 ? 's' : '' %></span>
</div>

<% if (books.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">📖</div>
    <h2>No books yet</h2>
    <p>Start building your library by adding the first book you've read.</p>
    <a href="/books/new" class="btn btn-primary">Add your first book</a>
  </div>
<% } else { %>
  <div class="book-grid">
    <% books.forEach(book => { %>
      <article class="book-card">
        <a href="/books/<%= book.id %>" class="card-cover-link">
          <div class="card-cover">
            <img
              src="<%= book.cover_url %>"
              alt="Cover of <%= book.title %>"
              loading="lazy"
              onerror="this.src='/images/no-cover.svg'"
            />
          </div>
        </a>
        <div class="card-body">
          <div class="card-rating">
            <% for (let i = 1; i <= 10; i++) { %>
              <span class="star <%= i <= book.rating ? 'filled' : '' %>">★</span>
            <% } %>
            <span class="rating-num"><%= book.rating %>/10</span>
          </div>
          <h2 class="card-title">
            <a href="/books/<%= book.id %>"><%= book.title %></a>
          </h2>
          <p class="card-author">by <%= book.author %></p>
          <% if (book.date_read) { %>
            <p class="card-date">
              Read <%= new Date(book.date_read).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) %>
            </p>
          <% } %>
          <p class="card-summary"><%= book.summary.substring(0, 140) %><%= book.summary.length > 140 ? '…' : '' %></p>
          <a href="/books/<%= book.id %>" class="card-link">Read my notes →</a>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
